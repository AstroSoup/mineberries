# PostgreSQL container and database bootstrap
POSTGRES_PORT=5432
POSTGRES_ADMIN_DB=mineberries_admin
POSTGRES_ADMIN_USER=mineberries_admin
POSTGRES_ADMIN_PASSWORD=change-me-postgres-admin
APP_DB_NAME=mineberries
APP_DB_USER=mineberries_app
APP_DB_PASSWORD=change-me-app-db
BOT_DB_NAME=mineberries_bots
BOT_DB_USER=mineberries_bots
BOT_DB_PASSWORD=change-me-bot-db

# RabbitMQ container and definitions bootstrap
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_VHOST=mineberries
RABBITMQ_ADMIN_USER=mineberries_admin
RABBITMQ_ADMIN_PASSWORD=change-me-rabbit-admin
RABBITMQ_APP_USER=mineberries_app
RABBITMQ_APP_PASSWORD=change-me-rabbit-app
RABBITMQ_BOT_USER=mineberries_bots
RABBITMQ_BOT_PASSWORD=change-me-rabbit-bots

# Service A (Spring Boot) reads standard Spring environment variables.
# Keep these aligned with the app database and app RabbitMQ user above.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/mineberries
SPRING_DATASOURCE_USERNAME=mineberries_app
SPRING_DATASOURCE_PASSWORD=change-me-app-db
SPRING_RABBITMQ_HOST=localhost
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=mineberries_app
SPRING_RABBITMQ_PASSWORD=change-me-rabbit-app
SPRING_RABBITMQ_VIRTUAL_HOST=mineberries

# Service B (TypeScript) reads these directly from the process environment.
# Keep these aligned with the bot database and bot RabbitMQ user above.
BOT_DB_HOST=localhost
BOT_DB_PORT=5432
BOT_DB_NAME=mineberries_bots
BOT_DB_USER=mineberries_bots
BOT_DB_PASSWORD=change-me-bot-db
BOT_RABBITMQ_HOST=localhost
BOT_RABBITMQ_PORT=5672
BOT_RABBITMQ_USERNAME=mineberries_bots
BOT_RABBITMQ_PASSWORD=change-me-rabbit-bots
BOT_RABBITMQ_VHOST=mineberries
